<category id="category_xiaobai" name="%{BKY_XIAOBAI}" colour="%{BKY_XIAOBAI_HUE}">
    <!-- ========== Serial 序列埠模組 ========== -->
    <category id="category_serial" name="%{BKY_SERIAL}" colour="%{BKY_XIAOBAI_HUE}">
        <!-- Serial Begin -->
        <block type="xiaobai_serial_begin">
            <field name="SERIAL_NAME">Serial</field>
            <field name="BAUD_RATE">9600</field>
        </block>
        
        <!-- Serial End -->
        <block type="xiaobai_serial_end">
            <field name="SERIAL_NAME">Serial</field>
        </block>
        
        <!-- Serial Print -->
        <block type="xiaobai_serial_print">
            <field name="SERIAL_NAME">Serial</field>
            <value name="TEXT">
                <shadow type="text">
                    <field name="TEXT">Hello</field>
                </shadow>
            </value>
        </block>
        
        <!-- Serial Println -->
        <block type="xiaobai_serial_println">
            <field name="SERIAL_NAME">Serial</field>
            <value name="TEXT">
                <shadow type="text">
                    <field name="TEXT">Hello</field>
                </shadow>
            </value>
        </block>
        
        <!-- Serial Available -->
        <block type="xiaobai_serial_available">
            <field name="SERIAL_NAME">Serial</field>
        </block>
        
        <!-- Serial Read -->
        <block type="xiaobai_serial_read">
            <field name="SERIAL_NAME">Serial</field>
        </block>
        
        <!-- Serial ReadStringUntil -->
        <block type="xiaobai_serial_readstringuntil">
            <field name="SERIAL_NAME">Serial</field>
            <value name="CHAR">
                <block type="xiaobai_breakline"></block>
            </value>
        </block>

        <!-- Serial Read Result -->
        <block type="xiaobai_serial_read_result"></block>
        
        <!-- Break Line -->
        <block type="xiaobai_breakline"></block>
    </category>
    
    <!-- ========== ESP32 模組 ========== -->
    <category id="category_esp32_io" name="%{BKY_ESP32_IO}" colour="200">
        <!-- 引腳模式設定 -->
        <block type="esp32_pin_mode">
            <field name="PIN">2</field>
            <field name="MODE">OUTPUT</field>
        </block>
        
        <!-- 數位寫入 -->
        <block type="esp32_digital_write">
            <field name="PIN">2</field>
            <value name="STATE">
                <shadow type="math_number">
                    <field name="NUM">1</field>
                </shadow>
            </value>
        </block>
        
        <!-- 數位讀取 -->
        <block type="esp32_digital_read">
            <field name="PIN">4</field>
        </block>
        
        <!-- 類比讀取 -->
        <block type="esp32_analog_read">
            <field name="PIN">34</field>
        </block>
        
        <!-- DAC 類比輸出 -->
        <block type="esp32_dac_write">
            <field name="PIN">25</field>
            <value name="VALUE">
                <shadow type="math_number">
                    <field name="NUM">128</field>
                </shadow>
            </value>
        </block>
        
        <!-- PWM 設定 -->
        <block type="esp32_pwm_setup">
            <value name="CHANNEL">
                <shadow type="math_number">
                    <field name="NUM">0</field>
                </shadow>
            </value>
            <value name="FREQ">
                <shadow type="math_number">
                    <field name="NUM">5000</field>
                </shadow>
            </value>
            <value name="RESOLUTION">
                <shadow type="math_number">
                    <field name="NUM">8</field>
                </shadow>
            </value>
        </block>
        
        <!-- PWM 輸出 -->
        <block type="esp32_pwm_write">
            <field name="PIN">2</field>
            <value name="CHANNEL">
                <shadow type="math_number">
                    <field name="NUM">0</field>
                </shadow>
            </value>
            <value name="VALUE">
                <shadow type="math_number">
                    <field name="NUM">128</field>
                </shadow>
            </value>
        </block>
    </category>
    <!-- ========== HX711 模組 ========== -->
    <category id="category_hx711" name="%{BKY_HX711}" colour="%{BKY_XIAOBAI_HUE}">
        <!-- HX711 初始化 -->
        <block type="hx711_init">
            <field name="NUM">1</field>
            <field name="DOUT">2</field>
            <field name="SCK">3</field>
        </block>
        
        <!-- HX711 讀取重量 -->
        <block type="hx711_read">
            <field name="NUM">1</field>
        </block>
        
        <!-- HX711 去皮歸零 -->
        <block type="hx711_tare">
            <field name="NUM">1</field>
        </block>
        
        <!-- HX711 校準 -->
        <block type="hx711_calibrate">
            <field name="NUM">1</field>
            <value name="SCALE">
                <shadow type="math_number">
                    <field name="NUM">1</field>
                </shadow>
            </value>
        </block>
        
        <!-- HX711 讀取原始值 -->
        <block type="hx711_read_raw">
            <field name="NUM">1</field>
        </block>
        
        <!-- HX711 設定增益 -->
        <block type="hx711_set_gain">
            <field name="NUM">1</field>
            <field name="GAIN">128</field>
        </block>
        
        <!-- HX711 檢測是否準備好 -->
        <block type="hx711_is_ready">
            <field name="NUM">1</field>
        </block>
    </category>
    
    <!-- ========== DRV8825 步進馬達模組 ========== -->
    <category id="category_drv8825" name="%{BKY_DRV8825}" colour="%{BKY_DRV8825_HUE}">
        <!-- DRV8825 初始化 -->
        <block type="drv8825_init">
            <field name="NUM">1</field>
            <field name="STEP_PIN">2</field>
            <field name="DIR_PIN">3</field>
            <field name="ENABLE_PIN">4</field>
            <field name="STEPS_PER_REV">24</field>
        </block>
        
        <!-- DRV8825 移動步數 -->
        <block type="drv8825_move_steps">
            <field name="NUM">1</field>
            <value name="STEPS">
                <shadow type="math_number">
                    <field name="NUM">24</field>
                </shadow>
            </value>
        </block>
        
        <!-- DRV8825 設定轉速 -->
        <block type="drv8825_set_speed">
            <field name="NUM">1</field>
            <value name="SPEED">
                <shadow type="math_number">
                    <field name="NUM">60</field>
                </shadow>
            </value>
        </block>
        
        <!-- DRV8825 連續旋轉 -->
        <block type="drv8825_run">
            <field name="NUM">1</field>
            <field name="DIRECTION">1</field>
        </block>
        
        <!-- DRV8825 停止 -->
        <block type="drv8825_stop">
            <field name="NUM">1</field>
        </block>
        
        <!-- DRV8825 啟用 -->
        <block type="drv8825_enable">
            <field name="NUM">1</field>
        </block>
        
        <!-- DRV8825 停用 -->
        <block type="drv8825_disable">
            <field name="NUM">1</field>
        </block>
        
        <!-- DRV8825 設定加速度 -->
        <block type="drv8825_set_acceleration">
            <field name="NUM">1</field>
            <value name="ACCEL">
                <shadow type="math_number">
                    <field name="NUM">500</field>
                </shadow>
            </value>
        </block>
        
        <!-- DRV8825 移動到限位器 -->
        <block type="drv8825_move_until_limit">
            <field name="NUM">1</field>
            <field name="DIRECTION">1</field>
            <field name="LIMIT_PIN">12</field>
            <field name="TRIGGER_STATE">HIGH</field>
        </block>
        
        <!-- DRV8825 連續旋轉到限位器 -->
        <block type="drv8825_run_until_limit">
            <field name="NUM">1</field>
            <field name="DIRECTION">1</field>
            <field name="LIMIT_PIN">12</field>
            <field name="TRIGGER_STATE">HIGH</field>
        </block>
    </category>
    
    <!-- ========== DS18B20 溫度感測器模組 ========== -->
    <category id="category_ds18b20" name="%{BKY_DS18B20}" colour="%{BKY_XIAOBAI_HUE}">
        <!-- DS18B20 初始化 -->
        <block type="xiaobai_ds18b20_init">
            <field name="PIN">4</field>
        </block>
        
        <!-- DS18B20 請求溫度 -->
        <block type="xiaobai_ds18b20_request"></block>
        
        <!-- DS18B20 讀取攝氏溫度 -->
        <block type="xiaobai_ds18b20_read_celsius"></block>
        
        <!-- DS18B20 讀取華氏溫度 -->
        <block type="xiaobai_ds18b20_read_fahrenheit"></block>
    </category>
    
    <!-- ========== MicroSD Card 記憶卡模組 ========== -->
    <category id="category_sdcard" name="%{BKY_SDCARD}" colour="%{BKY_XIAOBAI_HUE}">
        <!-- SD Card 初始化 -->
        <block type="xiaobai_sd_init">
            <field name="CS_PIN">5</field>
        </block>
        
        <!-- SD Card 狀態檢查 -->
        <block type="xiaobai_sd_is_ready"></block>
        
        <!-- SD Card 設定 CS 腳位 -->
        <block type="xiaobai_sd_set_cs">
            <value name="CS_PIN">
                <shadow type="math_number">
                    <field name="NUM">5</field>
                </shadow>
            </value>
        </block>
        
        <!-- SD Card 開啟檔案 -->
        <block type="xiaobai_sd_open">
            <field name="MODE">FILE_WRITE</field>
            <value name="FILENAME">
                <shadow type="text">
                    <field name="TEXT">data.txt</field>
                </shadow>
            </value>
        </block>
        
        <!-- SD Card 關閉檔案 -->
        <block type="xiaobai_sd_close"></block>
        
        <!-- SD Card 檔案是否開啟 -->
        <block type="xiaobai_sd_is_open"></block>
        
        <!-- SD Card 寫入資料 -->
        <block type="xiaobai_sd_write">
            <value name="DATA">
                <shadow type="text">
                    <field name="TEXT">Hello</field>
                </shadow>
            </value>
        </block>
        
        <!-- SD Card 寫入一行 -->
        <block type="xiaobai_sd_writeln">
            <value name="DATA">
                <shadow type="text">
                    <field name="TEXT">Hello</field>
                </shadow>
            </value>
        </block>
        
        <!-- SD Card 讀取一行 -->
        <block type="xiaobai_sd_readln"></block>
        
        <!-- SD Card 讀取直到指定字元 -->
        <block type="xiaobai_sd_readuntil_char">
            <value name="CHAR">
                <shadow type="text">
                    <field name="TEXT">\n</field>
                </shadow>
            </value>
        </block>
        
        <!-- SD Card 檔案有資料可讀取 -->
        <block type="xiaobai_sd_available"></block>
        
        <!-- SD Card 檔案是否存在 -->
        <block type="xiaobai_sd_exists">
            <value name="FILENAME">
                <shadow type="text">
                    <field name="TEXT">data.txt</field>
                </shadow>
            </value>
        </block>
        
        <!-- SD Card 刪除檔案 -->
        <block type="xiaobai_sd_remove">
            <value name="FILENAME">
                <shadow type="text">
                    <field name="TEXT">data.txt</field>
                </shadow>
            </value>
        </block>
        
        <!-- SD Card 建立目錄 -->
        <block type="xiaobai_sd_mkdir">
            <value name="DIRNAME">
                <shadow type="text">
                    <field name="TEXT">logs</field>
                </shadow>
            </value>
        </block>
        
        <sep gap="16"></sep>
        <label text="進階功能 Advanced"></label>
        
        <!-- SD Card 自訂 SPI 腳位初始化 -->
        <block type="xiaobai_sd_init_custom">
            <value name="CS_PIN">
                <shadow type="math_number">
                    <field name="NUM">5</field>
                </shadow>
            </value>
            <value name="MOSI_PIN">
                <shadow type="math_number">
                    <field name="NUM">23</field>
                </shadow>
            </value>
            <value name="MISO_PIN">
                <shadow type="math_number">
                    <field name="NUM">19</field>
                </shadow>
            </value>
            <value name="SCK_PIN">
                <shadow type="math_number">
                    <field name="NUM">18</field>
                </shadow>
            </value>
        </block>
        
        <!-- SD 宣告檔案變數 -->
        <block type="xiaobai_sd_file_var">
            <value name="VAR_NAME">
                <shadow type="text">
                    <field name="TEXT">myFile</field>
                </shadow>
            </value>
        </block>
        
        <!-- SD 檔案變數開啟 -->
        <block type="xiaobai_sd_open_adv">
            <field name="MODE">FILE_WRITE</field>
            <value name="VAR_NAME">
                <shadow type="text">
                    <field name="TEXT">myFile</field>
                </shadow>
            </value>
            <value name="FILENAME">
                <shadow type="text">
                    <field name="TEXT">data.txt</field>
                </shadow>
            </value>
        </block>
        
        <!-- SD 檔案變數關閉 -->
        <block type="xiaobai_sd_close_adv">
            <value name="VAR_NAME">
                <shadow type="text">
                    <field name="TEXT">myFile</field>
                </shadow>
            </value>
        </block>
        
        <!-- SD 檔案變數寫入 -->
        <block type="xiaobai_sd_write_adv">
            <value name="VAR_NAME">
                <shadow type="text">
                    <field name="TEXT">myFile</field>
                </shadow>
            </value>
            <value name="DATA">
                <shadow type="text">
                    <field name="TEXT">Hello</field>
                </shadow>
            </value>
        </block>
        
        <!-- SD 檔案變數寫入一行 -->
        <block type="xiaobai_sd_writeln_adv">
            <value name="VAR_NAME">
                <shadow type="text">
                    <field name="TEXT">myFile</field>
                </shadow>
            </value>
            <value name="DATA">
                <shadow type="text">
                    <field name="TEXT">Hello</field>
                </shadow>
            </value>
        </block>
        
        <!-- SD 檔案變數讀取一行 -->
        <block type="xiaobai_sd_readln_adv">
            <value name="VAR_NAME">
                <shadow type="text">
                    <field name="TEXT">myFile</field>
                </shadow>
            </value>
        </block>
        
        <!-- SD 檔案變數讀取直到指定字元 -->
        <block type="xiaobai_sd_readuntil_char_adv">
            <value name="VAR_NAME">
                <shadow type="text">
                    <field name="TEXT">myFile</field>
                </shadow>
            </value>
            <value name="CHAR">
                <shadow type="text">
                    <field name="TEXT">\n</field>
                </shadow>
            </value>
        </block>
        
        <!-- SD 檔案變數有資料 -->
        <block type="xiaobai_sd_available_adv">
            <value name="VAR_NAME">
                <shadow type="text">
                    <field name="TEXT">myFile</field>
                </shadow>
            </value>
        </block>
        
        <!-- SD 刪除目錄 -->
        <block type="xiaobai_sd_rmdir">
            <value name="DIRNAME">
                <shadow type="text">
                    <field name="TEXT">old_logs</field>
                </shadow>
            </value>
        </block>
    </category>
    
    <!-- ========== ESP-NOW 無線通訊模組 ========== -->
    <category id="category_espnow" name="%{BKY_ESPNOW}" colour="%{BKY_ESPNOW_HUE}">
        <!-- ESP-NOW 初始化 -->
        <block type="espnow_init"></block>
        
        <!-- 取得 MAC 位址 -->
        <block type="espnow_get_mac"></block>
        
        <!-- 新增對等裝置 -->
        <block type="espnow_add_peer">
            <value name="MAC">
                <shadow type="text">
                    <field name="TEXT">AA:BB:CC:DD:EE:FF</field>
                </shadow>
            </value>
        </block>
        
        <!-- 新增廣播位址 -->
        <block type="espnow_add_broadcast"></block>
        
        <sep gap="16"></sep>
        <label text="發送 Send"></label>
        
        <!-- 發送資料 -->
        <block type="espnow_send">
            <value name="DATA">
                <shadow type="text">
                    <field name="TEXT">Hello</field>
                </shadow>
            </value>
            <value name="MAC">
                <shadow type="text">
                    <field name="TEXT">AA:BB:CC:DD:EE:FF</field>
                </shadow>
            </value>
        </block>
        
        <!-- 廣播資料 -->
        <block type="espnow_broadcast">
            <value name="DATA">
                <shadow type="text">
                    <field name="TEXT">Hello</field>
                </shadow>
            </value>
        </block>
        
        <!-- 發送狀態 -->
        <block type="espnow_send_status"></block>
        
        <sep gap="16"></sep>
        <label text="接收 Receive"></label>
        
        <!-- 當收到資料時 -->
        <block type="espnow_on_receive"></block>
        
        <!-- 接收到的資料 -->
        <block type="espnow_received_data"></block>
        
        <!-- 發送者 MAC -->
        <block type="espnow_sender_mac"></block>
    </category>

</category>
